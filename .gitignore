# --- Project-specific ---
# any files/direcotries with 'secret' in the filename (e.g. _api_secrets.py)
*secret*

# Datasets / cached metadata
*dataset*
*database*
*metadata*
# ...but these are code, even though they are named after the data they load.
# Negations are listed explicitly: a blanket `!*.py` would also un-ignore
# `_api_secrets.py`, since the last matching pattern wins.
!*.ipynb
!analysis/helpers/dataset.py
!tests/test_*.py

# Documents and images (article drafts, figures, etc.)
manuscript/
output/
*.pdf
*.docx
*.doc
*.txt
!requirements.txt
*.png
*.tmp

# Source data plus the derived parquet frames (see helpers/config.py)
data_store/

# --- Python ---
__pycache__/

# Environments
.venv

# Jupyter
.ipynb_checkpoints

# Test
.pytest_cache/

# --- Editor ---
.idea/
