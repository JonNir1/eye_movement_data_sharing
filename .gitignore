# --- Project-specific ---
# any files/direcotries with 'secret' in the filename (e.g. _api_secrets.py)
*secret*

# Datasets / cached metadata
*dataset*
*database*
*metadata*
# ...but notebooks are code, even when named after the data they load
!*.ipynb

# Documents and images (article drafts, figures, etc.)
*.pdf
*.docx
*.doc
*.txt
!requirements.txt
*.png
*.tmp

# --- Python ---
# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# --- Editor ---
.idea/

# Derived dataset cache (regenerated by helpers/dataset.py)
.cache/
