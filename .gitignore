# --- Project-specific ---
# Python files with 'secret' in the filename (e.g. _api_secrets.py)
*secret*
# Datasets / cached metadata
*dataset*
*database*
*metadata*
# Word docs
*.docx
*.doc
# Text files (scratch dumps/exports); keep requirements.txt tracked
*.txt
!requirements.txt
*.tmp

# --- Python ---
# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# --- Editor ---
.idea/
